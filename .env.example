# Copy to .env locally. Never commit .env or real credentials.
NHD_ENVIRONMENT=development
NHD_LOG_LEVEL=INFO
# Keep the password below identical to POSTGRES_PASSWORD.
NHD_DATABASE_URL=postgresql+psycopg://nhd:replace-with-strong-local-secret@postgres:5432/nhd
NHD_REDIS_URL=redis://redis:6379/0
# Seeds system_settings on first boot only; the database value is authoritative afterwards.
NHD_PUBLISHING_KILL_SWITCH=true
# dry_run never calls Meta; live requires an explicit opt-in (docs/operations.md section 7).
NHD_PUBLISH_MODE=dry_run
POSTGRES_DB=nhd
POSTGRES_USER=nhd
POSTGRES_PASSWORD=replace-with-strong-local-secret

# Configure only after verifying current official provider docs and permissions.
ANTHROPIC_API_KEY=
# Image generation goes through fal.ai (FLUX models), not Black Forest Labs directly.
FAL_API_KEY=
GEMINI_API_KEY=
# Voiceover (decision D-24). Voice must be licensed for commercial use under your plan.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model IDs change; see docs/video-pipeline.md. Vietnamese is listed for eleven_flash_v2_5, eleven_v3, eleven_v4.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Meta (use the TEST Page first, decision D-20). Fill in your local .env only; never commit it
# and never paste tokens into chat, logs or screenshots.
# Required to publish: only these two.
META_PAGE_ID=
META_ACCESS_TOKEN=
# Optional: defaults to v26.0 (the version the docs described when this was written).
META_API_VERSION=
# Optional, only for a later token-health job (debug_token / token exchange). Leave empty for now.
META_APP_ID=
META_APP_SECRET=
FCM_PROJECT_ID=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Video rendering
NHD_FFMPEG_PATH=ffmpeg
NHD_FFPROBE_PATH=ffprobe
NHD_MAX_VIDEO_BYTES=104857600
