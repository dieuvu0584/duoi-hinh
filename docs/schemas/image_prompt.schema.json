{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nhd/image_prompt/2",
  "title": "ImagePromptResult",
  "description": "Lean (all fields required) so the structured-output endpoint accepts it. The model's own idea of where things sit is NOT trusted: clue boxes are measured later by a separate vision call and decided by backend code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "revision_reasons", "visual_blueprint", "flux_prompt", "negative_constraints",
    "expected_viewer_interpretation", "visual_explanation"
  ],
  "properties": {
    "status": { "enum": ["ok", "needs_revision"] },
    "revision_reasons": { "type": "array", "items": { "type": "string" } },
    "visual_blueprint": { "type": "string", "maxLength": 3000 },
    "flux_prompt": { "type": "string", "maxLength": 3000 },
    "negative_constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 12 },
    "expected_viewer_interpretation": { "type": "string", "maxLength": 1000 },
    "visual_explanation": { "type": "string", "maxLength": 1500 }
  }
}
