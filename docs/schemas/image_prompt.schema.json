{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nhd/image_prompt/1",
  "title": "ImagePromptResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["ok", "needs_revision"] },
    "revision_reasons": { "type": "array", "items": { "type": "string" } },
    "visual_blueprint": { "type": "string" },
    "composition": {
      "type": "object",
      "properties": {
        "master_canvas": { "const": "1920x1920" },
        "safe_square_norm": {
          "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
          "description": "[x0, y0, x1, y1] normalised; default [0.21875, 0.21875, 0.78125, 0.78125]"
        },
        "safe_zone_px": {
          "type": "object",
          "properties": { "top": { "type": "integer" }, "bottom": { "type": "integer" }, "side": { "type": "integer" } }
        },
        "clue_boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["clue_id", "box_norm"],
            "properties": { "clue_id": { "type": "string" }, "box_norm": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } }
          }
        }
      }
    },
    "image_prompts": {
      "type": "object",
      "required": ["flux", "gemini"],
      "properties": { "flux": { "type": "string" }, "gemini": { "type": "string" } }
    },
    "negative_constraints": { "type": "array", "items": { "type": "string" } },
    "expected_viewer_interpretation": { "type": "string" },
    "ambiguity_risks": { "type": "array", "items": { "type": "string" } },
    "image_explanation_ticket": {
      "type": "object",
      "required": ["answer_or_message", "intended_meaning", "visual_explanation", "clue_mapping"],
      "properties": {
        "answer_or_message": { "type": "string" },
        "intended_meaning": { "type": "string" },
        "visual_explanation": { "type": "string" },
        "clue_mapping": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
