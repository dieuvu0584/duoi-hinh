{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nhd/safety_review/1",
  "title": "SafetyReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "risk_level", "categories", "human_review_required", "policy_version", "reviewed_at"],
  "properties": {
    "gate": { "enum": ["intake", "final", "prepublish"] },
    "decision": { "enum": ["allow", "hold_for_human", "block"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "categories": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "description"],
        "properties": { "category": { "type": "string" }, "description": { "type": "string" }, "evidence_ref": { "type": "string" } }
      }
    },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "policy_version": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "reviewed_content_hash": { "type": "string", "description": "Echoed by the backend, not trusted from the model." }
  }
}
