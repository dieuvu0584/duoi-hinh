{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nhd/safety_review/2",
  "title": "SafetyReviewResult",
  "description": "Lean on purpose. The model only advises; the backend fills the content hash, timestamps, expiry and policy version, and derives whether a human must review (deterministic rules, never this output alone).",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "risk_level", "categories", "findings", "required_changes", "summary"],
  "properties": {
    "decision": { "enum": ["allow", "hold_for_human", "block"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "categories": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 12 },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "description"],
        "properties": {
          "category": { "type": "string", "maxLength": 60 },
          "description": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "required_changes": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 8 },
    "summary": { "type": "string", "maxLength": 600 }
  }
}
