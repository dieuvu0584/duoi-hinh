{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nhd/analyze_topic/2",
  "title": "AnalyzeTopicResult",
  "description": "Lean on purpose: every field is required and nothing is nested-optional, because the structured-output endpoint rejects complex schemas (verified 2026-10-22). Rebus syllables are derived by backend code from the owner-verified answer, not by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "reasons", "answer_or_message", "intended_viewer_inference", "clue_mapping",
    "ambiguity_risks", "risk_level", "sensitive_categories", "caption", "hashtags", "overlay_text",
    "narration_text", "reasoning_summary"
  ],
  "properties": {
    "decision": { "enum": ["proceed", "hold_for_human", "reject"] },
    "reasons": { "type": "array", "items": { "type": "string" }, "description": "Why hold or reject; empty when proceeding." },
    "answer_or_message": { "type": "string", "maxLength": 300 },
    "intended_viewer_inference": { "type": "string", "maxLength": 400 },
    "clue_mapping": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clue_id", "visual_clue", "maps_to", "operation"],
        "properties": {
          "clue_id": { "type": "string", "maxLength": 40 },
          "visual_clue": { "type": "string", "maxLength": 200 },
          "maps_to": { "type": "string", "maxLength": 200 },
          "operation": { "enum": ["literal", "homophone", "drop_tone", "add", "remove", "sound_alike", "position", "metaphor"] }
        }
      }
    },
    "ambiguity_risks": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "sensitive_categories": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "caption": { "type": "string", "maxLength": 300 },
    "hashtags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 5 },
    "overlay_text": { "type": "string", "maxLength": 200 },
    "narration_text": { "type": "string", "maxLength": 600 },
    "reasoning_summary": { "type": "string", "maxLength": 600 }
  }
}
